# Transcriber choices are dummy or whisper. Assistant choices are dummy or openai.
MEWLY_TRANSCRIBER=dummy
MEWLY_ASSISTANT=dummy
MEETING_CONTEXT=
# Set when using an OpenAI provider.
OPENAI_API_KEY=
WHISPER_MODEL=gpt-4o-transcribe
# Minimum batch length in seconds, rounded up to a full 3-second capture chunk.
WHISPER_WINDOW_SECONDS=6
ASSISTANT_MODEL=gpt-4o-mini
# Optional overrides for an OpenAI-compatible chat provider.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
